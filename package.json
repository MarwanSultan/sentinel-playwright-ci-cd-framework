{
  "name": "va-gov-test-automation",
  "version": "1.0.0",
  "description": "Comprehensive test automation for VA.gov veteran-facing functionalities using Playwright",
  "author": "VA.gov QA Team",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "dev": "nodemon --exec node --loader ts-node/esm src/index.ts",
    "build": "tsc && npm run build:dist",
    "build:dev": "tsc --sourceMap && npm run build:dist",
    "build:staging": "tsc && npm run build:dist",
    "build:prod": "tsc && npm run build:dist && npm run build:optimize",
    "build:dist": "echo 'Build artifacts ready in dist/'",
    "build:optimize": "echo 'Optimizing production build...'",
    "build:sourcemaps": "tsc --sourceMap",
    "lint": "eslint tests playwright.config.ts --ext .ts,.tsx",
    "lint:fix": "eslint tests playwright.config.ts --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint-staged": "lint-staged",
    "type-check": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e && npm run test:api",
    "test:unit": "playwright test tests",
    "test:unit:watch": "playwright test tests/unit --watch",
    "test:unit:coverage": "playwright test tests/unit",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:api": "playwright test tests/api",
    "test:api:watch": "playwright test tests/api --watch",
    "test:smoke": "playwright test tests/smoke/",
    "test:performance": "k6 run tests/performance/k6-load-tests.js",
    "test:watch": "npm run test:unit:watch",
    "test:ci": "npm run lint && npm run type-check && npm run test:unit && npm run test:api",
    "clean": "rm -rf dist coverage test-results build-reports",
    "clean:all": "npm run clean && rm -rf node_modules package-lock.json",
    "prebuild-script": "chmod +x scripts/*.sh",
    "build-script": "bash scripts/build.sh",
    "test-script": "bash scripts/test.sh",
    "deploy-script": "bash scripts/deploy.sh",
    "rollback-script": "bash scripts/rollback.sh",
    "docker:build": "docker build -t va-test-automation:latest .",
    "docker:build:dev": "docker build -t va-test-automation:dev --target development .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:test": "docker-compose run --rm test-automation npm run test",
    "docker:logs": "docker-compose logs -f",
    "ci": "npm run build-script && npm run test-script",
    "deploy:staging": "bash scripts/deploy.sh staging",
    "deploy:production": "bash scripts/deploy.sh production",
    "rollback:staging": "bash scripts/rollback.sh staging",
    "rollback:production": "bash scripts/rollback.sh production"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "lint-staged": "^15.0.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  }
}
